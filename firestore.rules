rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /catches/{catchId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && (request.resource.data.user_id == request.auth.uid
            || request.resource.data.user_id.matches('demo-.*'));
      allow update, delete: if request.auth != null
        && (resource.data.user_id == request.auth.uid
            || resource.data.user_id.matches('demo-.*'));
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && (request.auth.uid == userId || userId.matches('demo-.*'));

      match /followers/{followerId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == followerId
          && request.resource.data.status in ['pending', 'active']
          && (request.resource.data.status == 'active'
              ? !get(/databases/$(database)/documents/users/$(userId)).data.isPrivate
              : true);
        allow update: if request.auth != null && request.auth.uid == userId
          && resource.data.status == 'pending'
          && request.resource.data.status == 'active';
        allow delete: if request.auth != null
          && (request.auth.uid == followerId || request.auth.uid == userId);
      }

      match /following/{followingId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == userId
          && request.resource.data.status in ['pending', 'active'];
        // userId (follower) can update their own; followingId (the target) can accept pending requests
        allow update: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == followingId)
          && resource.data.status == 'pending'
          && request.resource.data.status == 'active';
        allow delete: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == followingId);
      }
    }

    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && (request.resource.data.uid == request.auth.uid
            || request.resource.data.uid.matches('demo-.*'));
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.uid.matches('demo-.*');
    }

    match /trips/{tripId} {
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        resource.data.visibility == 'everyone'
      );
      allow create: if request.auth != null
        && (request.resource.data.uid == request.auth.uid
            || request.resource.data.uid.matches('demo-.*'));
      allow update, delete: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || resource.data.uid.matches('demo-.*'));

      match /reactions/{userId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text.size() <= 500;
        allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
        allow update: if false;
      }
    }

    match /notifications/{uid}/items/{notifId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

  }
}
